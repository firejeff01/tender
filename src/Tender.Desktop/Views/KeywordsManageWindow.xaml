<Window x:Class="Tender.Desktop.Views.KeywordsManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tender.Desktop.ViewModels"
        Title="管理關鍵字"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Microsoft JhengHei UI">
    <DockPanel>
        <!-- 標題列 -->
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Border Width="3" Background="{StaticResource PrimaryBrush}" CornerRadius="1.5" Margin="0,2,10,2" />
                <TextBlock Text="關鍵字群組與項目管理" Style="{StaticResource HeaderTextStyle}" FontSize="17" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 底部 -->
        <Border DockPanel.Dock="Bottom" Padding="14"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="關閉" Padding="22,5" Margin="0,0,8,0" IsCancel="True" Click="Close_Click" />
                    <Button Content="💾 儲存" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="22,5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主體：左群組 / 右關鍵字 -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：群組清單 -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgAccentBrush}" Padding="10,6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="群組" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ 新群組" Command="{Binding AddGroupCommand}" Padding="8,4" Margin="0,0,4,0" />
                            <Button Content="− 刪群組" Command="{Binding DeleteGroupCommand}" Padding="8,4" />
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup}"
                             Background="Transparent" BorderThickness="0"
                             Padding="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EditableGroup}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Items.Count, StringFormat='({0})'}"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：關鍵字清單 -->
            <Border Grid.Column="1" Margin="12,0,0,0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgAccentBrush}" Padding="10,6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding SelectedGroup.Name, StringFormat='關鍵字：{0}', FallbackValue='關鍵字'}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Button DockPanel.Dock="Right" Content="+ 新關鍵字" Command="{Binding AddKeywordCommand}"
                                    Padding="10,4" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding SelectedGroup.Items}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="{StaticResource BgSubtleBrush}"
                              RowBackground="{StaticResource BgCardBrush}"
                              Background="{StaticResource BgCardBrush}"
                              BorderBrush="Transparent"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource BgSubtleBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="啟用" Binding="{Binding Enabled}" Width="50" />
                            <DataGridTextColumn Header="關鍵字" Binding="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridComboBoxColumn Header="比對欄位" SelectedItemBinding="{Binding TargetField}" Width="120">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.TargetFieldOptions, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.TargetFieldOptions, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTemplateColumn Header="刪除" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✖"
                                                Command="{Binding DataContext.DeleteKeywordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" FontSize="11"
                                                ToolTip="刪除此關鍵字" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
