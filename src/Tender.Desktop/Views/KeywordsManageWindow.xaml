<Window x:Class="Tender.Desktop.Views.KeywordsManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Tender.Desktop.Converters"
        xmlns:vm="clr-namespace:Tender.Desktop.ViewModels"
        AutomationProperties.AutomationId="KeywordsManageWindow"
        Title="篩選類別設定"
        Height="640" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Microsoft JhengHei UI">
    <Window.Resources>
        <conv:ColorStringToColorConverter x:Key="ColorStringToColor" />
    </Window.Resources>

    <DockPanel>
        <!-- 標題列 -->
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Border Width="3" Background="{StaticResource PrimaryBrush}" CornerRadius="1.5" Margin="0,2,10,2" />
                <TextBlock Text="篩選類別與項目設定" Style="{StaticResource HeaderTextStyle}" FontSize="17" VerticalAlignment="Center" />
                <TextBlock Text="（拖拉列首區域或按 ↑/↓ 重新排序；由上到下對應主畫面由左到右、下拉項目由上到下）"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 底部 -->
        <Border DockPanel.Dock="Bottom" Padding="14"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 合併新版預設"
                            AutomationProperties.AutomationId="MergeDefaultsButton"
                            Command="{Binding MergeEmbeddedDefaultsCommand}"
                            ToolTip="把內嵌新版預設裡「使用者尚未擁有」的群組／項目補進來；不會動到既有的順序、顏色與自訂項目"
                            Padding="14,5" Margin="0,0,8,0" />
                    <Button Content="關閉" AutomationProperties.AutomationId="CloseButton"
                            Padding="22,5" Margin="0,0,8,0" IsCancel="True" Click="Close_Click" />
                    <Button Content="💾 儲存" AutomationProperties.AutomationId="SaveButton"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="22,5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主體：左群組 / 右關鍵字 -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：群組清單 -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgAccentBrush}" Padding="10,6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="類別" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ 新類別" AutomationProperties.AutomationId="AddGroupButton"
                                    Command="{Binding AddGroupCommand}" Padding="8,4" Margin="0,0,4,0" />
                            <Button Content="− 刪類別" AutomationProperties.AutomationId="DeleteGroupButton"
                                    Command="{Binding DeleteGroupCommand}" Padding="8,4" />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="GroupsListBox"
                             AutomationProperties.AutomationId="GroupsListBox"
                             ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup}"
                             Background="Transparent" BorderThickness="0"
                             Padding="4"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EditableGroup}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 拖拉把手 -->
                                    <TextBlock Grid.Column="0" Text="⋮⋮"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,6,0" VerticalAlignment="Center"
                                               Cursor="SizeAll"
                                               ToolTip="拖拉以重新排序" />

                                    <!-- 顏色色塊 + popup 色盤 -->
                                    <ToggleButton x:Name="ColorBtn" Grid.Column="1" Width="18" Height="18"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Cursor="Hand"
                                                  ToolTip="點擊以變更顏色"
                                                  Background="Transparent" BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding Color, Converter={StaticResource ColorStringToColor}}" />
                                                    </Border.Background>
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=ColorBtn}"
                                           PlacementTarget="{Binding ElementName=ColorBtn}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                        <Border Background="{StaticResource BgCardBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="8">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#5C4A2E" BlurRadius="8" ShadowDepth="2" Opacity="0.18" />
                                            </Border.Effect>
                                            <ItemsControl ItemsSource="{Binding DataContext.PresetColors, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="5" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="22" Height="22" Margin="3"
                                                                Cursor="Hand"
                                                                Tag="{Binding}"
                                                                Click="ColorSwatch_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                                        <Border.Background>
                                                                            <SolidColorBrush Color="{Binding Converter={StaticResource ColorStringToColor}}" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Popup>

                                    <!-- 名稱 -->
                                    <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                             VerticalAlignment="Center" />

                                    <!-- 項目數 -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Items.Count, StringFormat='({0})'}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="6,0,6,0" VerticalAlignment="Center" />

                                    <!-- ↑ / ↓ -->
                                    <Button Grid.Column="4" Content="↑" FontSize="11" Padding="4,1" Margin="0,0,2,0"
                                            AutomationProperties.AutomationId="GroupMoveUpButton"
                                            ToolTip="往上"
                                            Command="{Binding DataContext.MoveGroupUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="5" Content="↓" FontSize="11" Padding="4,1"
                                            AutomationProperties.AutomationId="GroupMoveDownButton"
                                            ToolTip="往下"
                                            Command="{Binding DataContext.MoveGroupDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：項目清單 -->
            <Border Grid.Column="1" Margin="12,0,0,0"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgAccentBrush}" Padding="10,6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding SelectedGroup.Name, StringFormat='項目：{0}', FallbackValue='項目'}"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="+ 新項目" Command="{Binding AddKeywordCommand}"
                                    Padding="10,4" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>

                    <!-- 表頭 -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="啟用" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="關鍵字" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="3" Text="比對欄位" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="4" Text="↑" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="↓" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="刪除" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="KeywordsListBox"
                             ItemsSource="{Binding SelectedGroup.Items}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EditableKeyword}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⋮⋮"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Cursor="SizeAll"
                                               ToolTip="拖拉以重新排序" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0,0,0,1"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding DataContext.TargetFieldOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding TargetField}"
                                              VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Grid.Column="4" Content="↑" FontSize="11" Padding="2,1"
                                            ToolTip="往上"
                                            Command="{Binding DataContext.MoveKeywordUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="5" Content="↓" FontSize="11" Padding="2,1"
                                            ToolTip="往下"
                                            Command="{Binding DataContext.MoveKeywordDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="6" Content="✖" FontSize="11" Padding="4,2" HorizontalAlignment="Center"
                                            ToolTip="刪除此項目"
                                            Command="{Binding DataContext.DeleteKeywordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
