<UserControl x:Class="Tender.Desktop.Views.DailyQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tender.Desktop.Converters"
             xmlns:vm="clr-namespace:Tender.Desktop.ViewModels"
             xmlns:search="clr-namespace:Tender.Core.Search;assembly=Tender.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:ListJoinConverter x:Key="ListJoinConverter" />
        <conv:ColorStringToColorConverter x:Key="ColorStringToColor" />
        <conv:SortLabelConverter x:Key="SortLabel" />
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />

        <x:Array x:Key="SortKeyOptions" Type="{x:Type search:SortKey}">
            <search:SortKey>None</search:SortKey>
            <search:SortKey>AgencyName</search:SortKey>
            <search:SortKey>TenderName</search:SortKey>
            <search:SortKey>AnnouncementDate</search:SortKey>
            <search:SortKey>BidDeadline</search:SortKey>
            <search:SortKey>BudgetAmount</search:SortKey>
        </x:Array>
        <x:Array x:Key="SortDirectionOptions" Type="{x:Type search:SortDirection}">
            <search:SortDirection>Descending</search:SortDirection>
            <search:SortDirection>Ascending</search:SortDirection>
        </x:Array>

        <!-- 群組下拉 trigger 樣式 -->
        <Style x:Key="GroupDropdownTriggerStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 群組下拉 DataTemplate -->
        <DataTemplate DataType="{x:Type vm:KeywordGroupViewModel}">
            <Grid>
                <ToggleButton x:Name="dropdownTrigger" Style="{StaticResource GroupDropdownTriggerStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Margin="0,0,8,0" CornerRadius="2">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding AccentColor, Converter={StaticResource ColorStringToColor}}" />
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveCount, StringFormat='({0})'}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="Bold"
                                   Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text=" ▾" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=dropdownTrigger, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=dropdownTrigger}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="0" Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#5C4A2E" BlurRadius="10" ShadowDepth="2" Opacity="0.2" />
                        </Border.Effect>
                        <DockPanel MinWidth="220">
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource BgSubtleBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Padding="8" CornerRadius="0,0,6,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="全選" Command="{Binding SelectAllCommand}"
                                            FontSize="11" Padding="8,3" Margin="0,0,4,0" />
                                    <Button Content="清除" Command="{Binding ClearGroupCommand}"
                                            FontSize="11" Padding="8,3" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Buttons}" Padding="10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:KeywordButtonViewModel}">
                                            <CheckBox Content="{Binding Keyword}"
                                                      IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      Margin="2,3" Padding="4,0,0,0"
                                                      VerticalContentAlignment="Center" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource BgMainBrush}">
        <!-- 標題列 -->
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="◀ 前一日" Command="{Binding GoPreviousDayCommand}" Padding="10,5" Margin="0,0,8,0" />
                <Button Content="後一日 ▶" Command="{Binding GoNextDayCommand}" Padding="10,5" Margin="0,0,16,0" />
                <Border Width="3" Background="{StaticResource PrimaryBrush}" CornerRadius="1.5" Margin="0,2,8,2" />

                <!-- 起日：文字 + 📅 ToggleButton + Popup Calendar -->
                <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <ToggleButton x:Name="DateFromToggle"
                              Content="📅"
                              Padding="6,3" Margin="6,0,0,0" FontSize="13"
                              VerticalAlignment="Center" Cursor="Hand"
                              ToolTip="變更起日" />
                <Popup PlacementTarget="{Binding ElementName=DateFromToggle}"
                       Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=DateFromToggle}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="4"
                            SnapsToDevicePixels="True">
                        <Calendar SelectedDate="{Binding Date, Converter={StaticResource DateOnlyToDateTime}, Mode=TwoWay}"
                                  SelectedDatesChanged="DateFromCalendar_SelectedDatesChanged" />
                    </Border>
                </Popup>

                <TextBlock Text="～" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="10,0,10,0" />

                <!-- 訖日：同樣文字 + 📅 ToggleButton + Popup Calendar -->
                <TextBlock Text="{Binding DateTo, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='—'}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <ToggleButton x:Name="DateToToggle"
                              Content="📅"
                              Padding="6,3" Margin="6,0,0,0" FontSize="13"
                              VerticalAlignment="Center" Cursor="Hand"
                              ToolTip="變更訖日" />
                <Popup PlacementTarget="{Binding ElementName=DateToToggle}"
                       Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=DateToToggle}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="4"
                            SnapsToDevicePixels="True">
                        <Calendar SelectedDate="{Binding DateTo, Converter={StaticResource DateOnlyToDateTime}, Mode=TwoWay}"
                                  SelectedDatesChanged="DateToCalendar_SelectedDatesChanged" />
                    </Border>
                </Popup>

                <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="顯示 {0:N0} / 共 {1:N0} 筆">
                            <Binding Path="FilteredItems.Count" />
                            <Binding Path="AllItems.Count" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 工具列 -->
        <Border DockPanel.Dock="Top" Padding="14,8"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Text="搜尋：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding KeywordQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             Width="220" Height="28" Margin="4,0,0,0" VerticalContentAlignment="Center" />
                    <CheckBox Content="標題"
                              IsChecked="{Binding KeywordTitleOnly}"
                              VerticalAlignment="Center" Margin="6,0,0,0"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              ToolTip="僅比對標案名稱（不含機關名稱）" />
                    <CheckBox Content="排除"
                              IsChecked="{Binding KeywordExclude}"
                              VerticalAlignment="Center" Margin="6,0,0,0"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              ToolTip="反向搜尋：命中關鍵字的標案會被排除。可獨立於「標題」使用。&#x0a;多關鍵字以逗號分隔（任一命中即排除）" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Text="招標方式：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding AvailableTenderMethods}"
                              SelectedItem="{Binding SelectedTenderMethod}"
                              Width="180" Height="28" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Text="採購性質：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding AvailableProcurementTypes}"
                              SelectedItem="{Binding SelectedProcurementType}"
                              Width="100" Height="28" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Text="排序：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox SelectedItem="{Binding SortKey}"
                              ItemsSource="{StaticResource SortKeyOptions}"
                              Width="130" Height="28" Margin="4,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource SortLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox SelectedItem="{Binding SortDirection}"
                              ItemsSource="{StaticResource SortDirectionOptions}"
                              Width="130" Height="28">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource SortLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Text="預算：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding BudgetMin, TargetNullValue='', UpdateSourceTrigger=PropertyChanged, Delay=400}"
                             Width="110" Height="28" Margin="4,0,4,0" VerticalContentAlignment="Center"
                             ToolTip="最低金額（只接受純數字，空白表示不限）"
                             PreviewTextInput="DigitsOnly_PreviewTextInput"
                             DataObject.Pasting="DigitsOnly_Pasting" />
                    <TextBlock Text="~" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding BudgetMax, TargetNullValue='', UpdateSourceTrigger=PropertyChanged, Delay=400}"
                             Width="110" Height="28" Margin="4,0,0,0" VerticalContentAlignment="Center"
                             ToolTip="最高金額（只接受純數字，空白表示不限）"
                             PreviewTextInput="DigitsOnly_PreviewTextInput"
                             DataObject.Pasting="DigitsOnly_Pasting" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Text="截止投標：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <DatePicker SelectedDate="{Binding BidDeadlineFrom}" Width="130" Height="28" Margin="4,0,4,0"
                                ToolTip="起始日（空白表示不限）" />
                    <TextBlock Text="~" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <DatePicker SelectedDate="{Binding BidDeadlineTo}" Width="130" Height="28" Margin="4,0,0,0"
                                ToolTip="迄止日（空白表示不限）" />
                </StackPanel>

                <CheckBox Content="只看尚未截止" IsChecked="{Binding ShowActiveOnly}"
                          VerticalAlignment="Center" Margin="0,0,12,4"
                          Foreground="{StaticResource TextPrimaryBrush}" />

                <CheckBox Content="⭐ 只看收藏" IsChecked="{Binding ShowFavoritesOnly}"
                          VerticalAlignment="Center" Margin="0,0,12,4"
                          Foreground="{StaticResource TextPrimaryBrush}" />

                <CheckBox Content="📬 只看未讀" IsChecked="{Binding ShowUnreadOnly}"
                          VerticalAlignment="Center" Margin="0,0,12,4"
                          Foreground="{StaticResource TextPrimaryBrush}" />

                <CheckBox Content="🚫 顯示已排除" IsChecked="{Binding ShowExcluded}"
                          VerticalAlignment="Center" Margin="0,0,16,4"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          ToolTip="預設不顯示已標記排除的標案" />

                <Button Content="🧹 清除全部篩選" Command="{Binding ClearAllFiltersCommand}" Padding="10,5" Margin="0,0,8,4" />

                <!-- 批次標記下拉 -->
                <Grid Margin="0,0,8,4">
                    <ToggleButton x:Name="batchMarkToggle" Padding="10,5" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bm" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bm" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bm" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 批次標記" />
                            <TextBlock Text=" ▾" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=batchMarkToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=batchMarkToggle}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,4,0,0" MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect Color="#5C4A2E" BlurRadius="10" ShadowDepth="2" Opacity="0.2" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="套用於目前篩選結果" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="6,4,6,6" />
                                <Button Content="📭 全部標記為已讀"
                                        Command="{Binding MarkAllAsReadCommand}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,6" Margin="0,1" />
                                <Button Content="📬 全部標記為未讀"
                                        Command="{Binding MarkAllAsUnreadCommand}"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,6" Margin="0,1" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 儲存搜尋條件 popup -->
                <Grid Margin="0,0,0,4">
                    <ToggleButton x:Name="savedSearchToggle" Padding="10,5" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="b" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔖 儲存搜尋" />
                            <TextBlock Text=" ▾" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=savedSearchToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=savedSearchToggle}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0" MinWidth="280">
                            <Border.Effect>
                                <DropShadowEffect Color="#5C4A2E" BlurRadius="10" ShadowDepth="2" Opacity="0.2" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="儲存目前條件為..." FontWeight="SemiBold" Margin="0,0,0,4" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="💾 存"
                                            Command="{Binding SaveCurrentSearchCommand}"
                                            CommandParameter="{Binding ElementName=newSearchName, Path=Text}"
                                            Padding="8,3" Margin="6,0,0,0" />
                                    <TextBox x:Name="newSearchName" Height="28" VerticalContentAlignment="Center" />
                                </DockPanel>
                                <Separator Margin="0,8" />
                                <TextBlock Text="已儲存的條件" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding SavedSearches}" MaxHeight="240">
                                    <ItemsControl.Template>
                                        <ControlTemplate>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Content="✖"
                                                        Command="{Binding DataContext.DeleteSavedSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,2" FontSize="11" Margin="2,0,0,0" />
                                                <Button Content="{Binding Name}"
                                                        Command="{Binding DataContext.ApplySavedSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Left" Padding="8,4" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="（無儲存條件）" Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding SavedSearches.Count, Converter={StaticResource ZeroToVis}, ConverterParameter=Inverse}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </WrapPanel>
        </Border>

        <!-- 關鍵字下拉群組區 + 即時筆數 -->
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border DockPanel.Dock="Right"
                        Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,7" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="符合" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FilteredItems.Count, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   Margin="8,0" />
                        <TextBlock Text="筆" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding KeywordGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="⏳ 載入中..."
                   HorizontalAlignment="Center" Margin="0,8"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="600" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="{StaticResource BgSubtleBrush}"
                      RowBackground="{StaticResource BgCardBrush}"
                      Background="{StaticResource BgMainBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      HeadersVisibility="Column"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding OpenDetailCommand}"
                                  CommandParameter="{Binding SelectedItem}" />
                </DataGrid.InputBindings>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BgAccentBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="6,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- ★ 收藏 -->
                    <DataGridTemplateColumn Header="收藏" Width="60" MinWidth="60" SortMemberPath="IsFavorite">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsFavorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="收藏">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <TextBlock x:Name="star" Text="☆" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="star" Property="Text" Value="★" />
                                                    <Setter TargetName="star" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- 已讀 -->
                    <DataGridTemplateColumn Header="已讀" Width="60" MinWidth="60" SortMemberPath="IsRead">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsRead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="已讀">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <TextBlock x:Name="r" Text="●" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Cursor="Hand" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="r" Property="Text" Value="○" />
                                                    <Setter TargetName="r" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- 排除 -->
                    <DataGridTemplateColumn Header="排除" Width="60" MinWidth="60" SortMemberPath="IsExcluded">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsExcluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="標記排除（預設此後不再顯示，需勾「顯示已排除」才看得到）">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <TextBlock x:Name="x" Text="✖" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="x" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="機關名稱" Binding="{Binding AgencyName}" Width="180" MinWidth="140" />
                    <DataGridTextColumn Header="標案名稱" Binding="{Binding TenderName}" Width="*" MinWidth="320" />
                    <DataGridTextColumn Header="招標方式" Binding="{Binding TenderMethod}" Width="120" MinWidth="100" />
                    <DataGridTextColumn Header="採購性質" Binding="{Binding ProcurementType}" Width="80" MinWidth="70" />
                    <DataGridTextColumn Header="公告日期" Binding="{Binding AnnouncementDate}" Width="90" MinWidth="80" />
                    <DataGridTextColumn Header="截止投標" Binding="{Binding BidDeadline}" Width="90" MinWidth="80" />
                    <DataGridTextColumn Header="預算金額" Binding="{Binding BudgetAmount, StringFormat='{}{0:N0}'}" Width="120" MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="命中關鍵字"
                                        Binding="{Binding MatchedKeywords, Converter={StaticResource ListJoinConverter}}"
                                        Width="180" MinWidth="140" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 拖曳分隔條：可調整左右寬度 -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Cursor="SizeWE" />

            <!-- 詳情面板 -->
            <Border Grid.Column="2"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    Background="{StaticResource BgCardBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Background="{StaticResource BgAccentBrush}" CornerRadius="5" Padding="10,6" Margin="0,0,0,12">
                            <TextBlock Text="📋 標案詳情" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding SelectedItem.TenderName}" FontWeight="SemiBold" FontSize="14"
                                       TextWrapping="Wrap" Margin="0,0,0,12"
                                       Foreground="{StaticResource TextPrimaryBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="機關名稱" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.AgencyName}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="案號" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.TenderNo, FallbackValue='—', TargetNullValue='—'}" Margin="0,6,0,0" Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="招標方式" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.TenderMethod}" Margin="0,6,0,0" Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="採購性質" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.ProcurementType, FallbackValue='—', TargetNullValue='—'}" Margin="0,6,0,0" Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="公告日期" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.AnnouncementDate}" Margin="0,6,0,0" Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="截止投標" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.BidDeadline, FallbackValue='—', TargetNullValue='—'}" Margin="0,6,0,0" Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="預算金額" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedItem.BudgetAmount, StringFormat='{}{0:N0} 元', FallbackValue='—', TargetNullValue='—'}" Margin="0,6,0,0" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="命中關鍵字" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="7" Grid.Column="1"
                                           Text="{Binding SelectedItem.MatchedKeywords, Converter={StaticResource ListJoinConverter}, FallbackValue='—'}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>

                            <!-- 標記快速 toggle -->
                            <Border Background="{StaticResource BgSubtleBrush}" CornerRadius="5" Padding="10,8" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="個人標記" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="⭐ 收藏" IsChecked="{Binding SelectedItem.IsFavorite}" Margin="0,0,12,0"
                                                  Foreground="{StaticResource TextPrimaryBrush}" />
                                        <CheckBox Content="📬 已讀" IsChecked="{Binding SelectedItem.IsRead}" Margin="0,0,12,0"
                                                  Foreground="{StaticResource TextPrimaryBrush}" />
                                        <CheckBox Content="🚫 排除" IsChecked="{Binding SelectedItem.IsExcluded}"
                                                  Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="備註" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4" />
                                    <TextBox Text="{Binding SelectedItem.Note, UpdateSourceTrigger=LostFocus}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="56" MaxHeight="120"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>

                            <Button Content="🔗 在瀏覽器開啟詳情頁"
                                    Command="{Binding OpenDetailCommand}"
                                    CommandParameter="{Binding SelectedItem}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="14,7" Margin="0,12,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Text="（從左方點選標案以顯示詳情）"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
