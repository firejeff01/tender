<Window x:Class="Tender.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tender.Desktop.ViewModels"
        xmlns:views="clr-namespace:Tender.Desktop.Views"
        Title="政府電子採購網 標案查詢"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Icon="/AppIcon.ico"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Microsoft JhengHei UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate DataType="{x:Type vm:MonthlyCalendarViewModel}">
            <views:MonthlyCalendarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DailyQueryViewModel}">
            <views:DailyQueryView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 上方工具列 -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <!-- 左側：返回 + 標題 + 設定 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="◀ 返回行事曆"
                            Command="{Binding NavigateBackToCalendarCommand}"
                            Visibility="{Binding IsDailyQueryVisible, Converter={StaticResource BoolToVis}}"
                            Padding="10,5" Margin="0,0,14,0" />
                    <Border Width="3" Background="{StaticResource PrimaryBrush}" CornerRadius="1.5" Margin="0,2,10,2" />
                    <TextBlock Text="政府電子採購網 標案查詢"
                               Style="{StaticResource HeaderTextStyle}"
                               FontSize="17"
                               VerticalAlignment="Center" />

                    <!-- 設定選單 -->
                    <Grid Margin="20,0,0,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="SettingsMenuButton" Content="⚙ 設定" Padding="10,5" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" Background="{StaticResource BgCardBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=SettingsMenuButton, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=SettingsMenuButton}"
                               Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="6" Margin="0,4,0,0" MinWidth="170">
                                <Border.Effect>
                                    <DropShadowEffect Color="#5C4A2E" BlurRadius="10" ShadowDepth="2" Opacity="0.2" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="🔧 管理關鍵字"
                                            Command="{Binding OpenKeywordsManagerCommand}"
                                            Click="MenuItem_Click"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,6" Margin="0,1" />
                                    <Button Content="⚙ 應用設定"
                                            Command="{Binding OpenAppSettingsCommand}"
                                            Click="MenuItem_Click"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,6" Margin="0,1" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- 右側：匯出 + 立即更新 + 進度 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding CrawlerStatusMessage}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,12,0"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding CrawlerProgressValue}"
                                 Minimum="0" Maximum="100"
                                 Width="120" Height="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Background="{StaticResource BgAccentBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Visibility="{Binding IsCrawlerRunning, Converter={StaticResource BoolToVis}}" />

                    <!-- 列印：只在查詢頁時顯示 -->
                    <Button Content="🖨 列印"
                            Command="{Binding CurrentDailyQueryVm.PrintCommand}"
                            Visibility="{Binding IsDailyQueryVisible, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource InfoBrush}"
                            Foreground="{StaticResource TextOnPrimaryBrush}"
                            BorderBrush="{StaticResource InfoBrush}"
                            Padding="12,5" Margin="0,0,8,0" />

                    <!-- 匯出 ISMS xlsm：僅在「資安/無障礙」單獨勾選 ISMS、且「ESG/碳管理」皆未勾選時可點 -->
                    <Button Content="🛡 匯出 ISMS xlsm"
                            Command="{Binding CurrentDailyQueryVm.ExportIsmsXlsmCommand}"
                            Visibility="{Binding IsDailyQueryVisible, Converter={StaticResource BoolToVis}}"
                            Background="#3F6FA6"
                            Foreground="{StaticResource TextOnPrimaryBrush}"
                            BorderBrush="#2F5586"
                            Padding="12,5" Margin="0,0,8,0"
                            ToolTip="匯出 ISMS 標案範本（含 ISMS 專屬 VBA 巨集）&#x0a;條件：「資安/無障礙」群組單獨勾選 ISMS，且「ESG/碳管理」群組未勾選任何項目" />

                    <!-- 匯出 ESG xlsm：僅在「ESG/碳管理」有勾選、且「資安/無障礙」皆未勾選時可點 -->
                    <Button Content="🍃 匯出 ESG xlsm"
                            Command="{Binding CurrentDailyQueryVm.ExportEsgXlsmCommand}"
                            Visibility="{Binding IsDailyQueryVisible, Converter={StaticResource BoolToVis}}"
                            Background="#5B8F5B"
                            Foreground="{StaticResource TextOnPrimaryBrush}"
                            BorderBrush="#3F6F3F"
                            Padding="12,5" Margin="0,0,8,0"
                            ToolTip="匯出 ESG 標案範本（含 ESG 專屬 VBA 巨集）&#x0a;條件：「ESG/碳管理」群組至少勾選一項，且「資安/無障礙」群組未勾選任何項目" />

                    <!-- 匯出 xlsm（含巨集模板）：只在查詢頁時顯示，置於匯出 Excel 左側 -->
                    <Button Content="📑 匯出 xlsm"
                            Command="{Binding CurrentDailyQueryVm.ExportXlsmCommand}"
                            Visibility="{Binding IsDailyQueryVisible, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource WarningBrush}"
                            Foreground="{StaticResource TextOnPrimaryBrush}"
                            BorderBrush="{StaticResource WarningBrush}"
                            Padding="12,5" Margin="0,0,8,0"
                            ToolTip="匯出為 .xlsm（含 88 個關鍵字按鈕與 VBA 巨集）" />

                    <!-- 匯出 Excel：只在查詢頁時顯示 -->
                    <Button Content="📊 匯出 Excel"
                            Command="{Binding CurrentDailyQueryVm.ExportCommand}"
                            Visibility="{Binding IsDailyQueryVisible, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,5" Margin="0,0,8,0" />

                    <!-- 立即更新（今日已成功 → 變綠） -->
                    <Button Content="🔄 立即更新（今日）"
                            Command="{Binding RunCrawlerNowCommand}"
                            Padding="12,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTodayCrawled}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextOnPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid />
            </DockPanel>
        </Border>

        <!-- 更新提示 banner（IsUpdateAvailable=true 時顯示） -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource WarningLightBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                Cursor="Hand">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenUpdatePageCommand}" />
            </Border.InputBindings>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="🆕" FontSize="14" />
                    <Run Text=" 有新版本可下載：" />
                    <Run Text="{Binding UpdateInfo.LatestVersion, FallbackValue=''}" FontWeight="Bold" />
                    <Run Text=" （目前 v" />
                    <Run Text="{Binding UpdateInfo.CurrentVersion, FallbackValue=''}" />
                    <Run Text="）" />
                </TextBlock>
                <TextBlock DockPanel.Dock="Right"
                           Text="點此下載 →"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource WarningBrush}"
                           FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- 中央內容 -->
        <ContentControl>
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Content" Value="{Binding CalendarVm}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDailyQueryVisible}" Value="True">
                            <Setter Property="Content" Value="{Binding CurrentDailyQueryVm}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DockPanel>
</Window>
