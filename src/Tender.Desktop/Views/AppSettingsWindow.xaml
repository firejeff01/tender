<Window x:Class="Tender.Desktop.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="應用設定"
        Height="430" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Microsoft JhengHei UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Border Width="3" Background="{StaticResource PrimaryBrush}" CornerRadius="1.5" Margin="0,2,10,2" />
                <TextBlock Text="應用設定" Style="{StaticResource HeaderTextStyle}" FontSize="17" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="14"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="關閉" Padding="22,5" Margin="0,0,8,0" IsCancel="True" Click="Close_Click" />
                    <Button Content="💾 儲存" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="22,5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="20">
            <TextBlock Text="爬蟲設定" Style="{StaticResource HeaderTextStyle}" FontSize="14" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="排程執行時間" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,8">
                    <TextBlock DockPanel.Dock="Right" Text="（HH:mm，預設 17:00）"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}"
                             Width="100" Height="28" VerticalContentAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="啟動時自動補跑" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding CatchupEnabled}"
                          Content="若 17:00 後啟動且今日無資料則自動補跑"
                          VerticalAlignment="Center" Margin="0,8"
                          Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="請求間隔（毫秒）" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8">
                    <TextBlock DockPanel.Dock="Right" Text="（建議 ≥ 1500，禮貌爬取）"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Text="{Binding RequestDelayMs, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Width="100" Height="28" VerticalContentAlignment="Center" />
                </DockPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="最大重試次數" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,8">
                    <TextBlock DockPanel.Dock="Right" Text="（網路錯誤時的指數退避重試上限）"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged}"
                             Width="100" Height="28" VerticalContentAlignment="Center" />
                </DockPanel>
            </Grid>

            <Border Background="{StaticResource WarningLightBrush}" BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12,8">
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12">
                    <Run Text="⚠" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" />
                    <Run Text="排程執行時間變動後，需到 Task Scheduler 修改 TenderSearch.DailyCrawl 任務的觸發時間，或重新執行「開始功能表 → 建立每日排程」捷徑（需系統管理員權限）。" />
                </TextBlock>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
