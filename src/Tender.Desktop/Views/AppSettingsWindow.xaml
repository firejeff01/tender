<Window x:Class="Tender.Desktop.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="AppSettingsWindow"
        Title="應用設定"
        Height="780" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgMainBrush}"
        FontFamily="Microsoft JhengHei UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="14,10"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Border Width="3" Background="{StaticResource PrimaryBrush}" CornerRadius="1.5" Margin="0,2,10,2" />
                <TextBlock Text="應用設定" Style="{StaticResource HeaderTextStyle}" FontSize="17" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="14"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="關閉" AutomationProperties.AutomationId="CloseButton"
                            Padding="22,5" Margin="0,0,8,0" IsCancel="True" Click="Close_Click" />
                    <Button Content="💾 儲存" AutomationProperties.AutomationId="SaveButton"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="22,5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="20">
            <TextBlock Text="爬蟲設定" Style="{StaticResource HeaderTextStyle}" FontSize="14" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="排程執行時間" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" VerticalContentAlignment="Center"
                         HorizontalAlignment="Stretch" Margin="0,8" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="（HH:mm，預設 17:00）"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,8,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="啟動時自動補跑" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          IsChecked="{Binding CatchupEnabled}"
                          VerticalAlignment="Center" Margin="0,8"
                          Foreground="{StaticResource TextPrimaryBrush}">
                    <TextBlock>
                        <Run Text="若 " /><Run Text="{Binding ScheduledTime}" /><Run Text=" 後啟動且今日無資料則自動補跑" />
                    </TextBlock>
                </CheckBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="檢查更新" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          IsChecked="{Binding UpdateCheckEnabled}"
                          Content="啟動時呼叫 GitHub API 檢查新版本（關閉後不會發生任何外連到 api.github.com）"
                          VerticalAlignment="Center" Margin="0,8"
                          Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="請求間隔（毫秒）" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding RequestDelayMs, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Height="28" VerticalContentAlignment="Center"
                         HorizontalAlignment="Stretch" Margin="0,8" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="（建議 ≥ 1500，禮貌爬取）"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,8,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="最大重試次數" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" VerticalContentAlignment="Center"
                         HorizontalAlignment="Stretch" Margin="0,8" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="（網路錯誤時的指數退避重試上限）"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,8,0,8" TextWrapping="Wrap" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="資料保留月數" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8" />
                <TextBox Grid.Row="5" Grid.Column="1"
                         Text="{Binding DataRetentionMonths, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" VerticalContentAlignment="Center"
                         HorizontalAlignment="Stretch" Margin="0,8" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="（超過此月份自動清除；0=永不刪除）"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,8,0,8" TextWrapping="Wrap" />
            </Grid>

            <TextBlock Text="資料儲存位置" Style="{StaticResource HeaderTextStyle}" FontSize="14" Margin="0,4,0,8" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0"
                         Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" VerticalContentAlignment="Center"
                         HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                <Button Grid.Row="0" Grid.Column="1" Content="瀏覽..."
                        Command="{Binding BrowseDataRootCommand}"
                        Padding="14,4" Margin="0,0,6,0" />
                <Button Grid.Row="0" Grid.Column="2" Content="還原預設"
                        Command="{Binding ResetDataRootCommand}"
                        Padding="14,4" />

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0">
                    <Run Text="預設：" /><Run Text="{Binding DefaultDataRoot, Mode=OneWay}" />
                </TextBlock>
            </Grid>

            <TextBlock Text="爬取的招標方式" Style="{StaticResource HeaderTextStyle}" FontSize="14" Margin="0,16,0,8" />
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding TenderMethodOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Background="{StaticResource WarningLightBrush}" BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12,8">
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12">
                    <Run Text="⚠" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" />
                    <Run Text="排程時間變更後會自動以使用者層級覆寫 Task Scheduler 任務，不需系統管理員權限。若公司 Group Policy 禁用 schtasks 而無法建立，可從「開始功能表 → 建立每日排程」捷徑手動執行。" />
                </TextBlock>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
